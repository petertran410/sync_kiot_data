// ---------------------------------------------------------------------------
// Product sub-entities. product.service.ts already requests includeSerials,
// includeBatchExpires, includeWarranties and the units[] array, but before
// these tables existed the payload was parsed and thrown away.
// branchId holds the local Branch.id and is stored without an FK relation,
// matching the existing ProductInventory precedent.
// ---------------------------------------------------------------------------

/// Unit variants of a product (doc 2.4.1 / 2.4.2 `units[]`).
/// Each unit is itself a product in KiotViet with its own id/code.
model ProductUnit {
  id              Int      @id @default(autoincrement())
  productId       Int
  unitKiotVietId  BigInt
  code            String?
  name            String?
  fullName        String?
  unit            String?
  conversionValue Float?
  basePrice       Decimal? @db.Decimal(15, 2)
  isCurrent       Boolean  @default(true)
  lastSyncedAt    DateTime @default(now())
  product         Product  @relation(fields: [productId], references: [id])

  @@unique([productId, unitKiotVietId])
  @@index([productId])
  @@index([unitKiotVietId])
  @@index([isCurrent])
}

/// Serial / IMEI records (doc 2.4.1 `productSerials[]`).
model ProductSerial {
  id           Int       @id @default(autoincrement())
  productId    Int
  branchId     Int?
  serialNumber String
  status       Int?
  quantity     Float?
  isCurrent    Boolean   @default(true)
  createdDate  DateTime?
  modifiedDate DateTime?
  lastSyncedAt DateTime  @default(now())
  product      Product   @relation(fields: [productId], references: [id])

  @@unique([productId, branchId, serialNumber])
  @@index([productId])
  @@index([branchId])
  @@index([serialNumber])
  @@index([isCurrent])
}

/// Batch / expiry records (doc 2.4.1 `productBatchExpires[]`).
model ProductBatchExpire {
  id              Int       @id @default(autoincrement())
  productId       Int
  branchId        Int?
  batchName       String
  onHand          Float?
  expireDate      DateTime?
  fullNameVirgule String?
  isCurrent       Boolean   @default(true)
  lastSyncedAt    DateTime  @default(now())
  product         Product   @relation(fields: [productId], references: [id])

  @@unique([productId, branchId, batchName])
  @@index([productId])
  @@index([branchId])
  @@index([batchName])
  @@index([expireDate])
  @@index([isCurrent])
}

/// Warranty / maintenance records (doc 2.4.1 `productWarranties[]`).
/// timeType: 1=day 2=month 3=year. warrantyType: 1=warranty 3=maintenance.
model ProductWarranty {
  id           Int       @id @default(autoincrement())
  kiotVietId   BigInt    @unique
  productId    Int
  description  String?
  numberTime   Int?
  timeType     Int?
  warrantyType Int?
  retailerId   Int?
  createdBy    BigInt?
  isCurrent    Boolean   @default(true)
  createdDate  DateTime?
  modifiedDate DateTime?
  lastSyncedAt DateTime  @default(now())
  product      Product   @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([kiotVietId])
  @@index([isCurrent])
}

// ---------------------------------------------------------------------------
// Durable webhook queue. The controller does exactly one INSERT here and
// returns 200 immediately, so the KiotViet 5s budget (doc 2.11) is never at
// risk. A worker drains the table separately.
// ---------------------------------------------------------------------------

model WebhookEvent {
  id             Int       @id @default(autoincrement())
  /// Notifications[].Id from the payload. Null when KiotViet omits it.
  notificationId String?
  /// Raw event type, e.g. "product.update" / "customer.delete".
  type           String
  /// Entity family parsed from `type`, e.g. "product".
  entity         String
  /// Verb parsed from `type`: "update" | "delete".
  action         String
  /// KiotViet id of the subject, used to coalesce redundant events.
  entityId       String?
  /// Stable idempotency key. A redelivery of the same event collides here
  /// instead of being processed twice.
  dedupKey       String    @unique
  payload        Json
  /// KiotViet's own delivery attempt counter from the envelope (`Attempt`).
  /// Distinct from `attempts`, which counts OUR processing retries.
  sourceAttempt  Int?
  /// pending | processing | done | failed | dead
  status         String    @default("pending")
  attempts       Int       @default(0)
  maxAttempts    Int       @default(8)
  lastError      String?
  /// Next eligible processing time; drives exponential backoff.
  availableAt    DateTime  @default(now())
  receivedAt     DateTime  @default(now())
  startedAt      DateTime?
  processedAt    DateTime?

  @@index([status, availableAt])
  @@index([entity, entityId])
  @@index([type])
  @@index([receivedAt])
  @@index([notificationId])
}

/// SePay bank transactions. This single table is both the immutable webhook
/// ledger and the small processing queue for matching KiotViet documents.
model SePayTransaction {
  id                 Int       @id @default(autoincrement())
  sepayTransactionId String    @unique
  gateway            String?
  transactionDate    DateTime
  accountNumber      String
  subAccount         String?
  code               String?
  content            String
  transferType       String
  transferAmount     Decimal   @db.Decimal(15, 2)
  accumulated        Decimal?  @db.Decimal(15, 2)
  description        String?
  referenceCode      String?
  rawPayload         Json
  documentType       String?
  documentCode       String?
  kiotDocumentId     BigInt?
  kiotCustomerId     BigInt?
  kiotBranchId       Int?
  kiotAccountId      Int?
  kiotPaymentId      BigInt?
  kiotPaymentCode    String?
  status             String    @default("RECEIVED")
  attempts           Int       @default(0)
  errorMessage       String?
  availableAt        DateTime  @default(now())
  receivedAt         DateTime  @default(now())
  startedAt          DateTime?
  writeStartedAt     DateTime?
  processedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status, availableAt])
  @@index([documentCode])
  @@index([transactionDate])
  @@index([accountNumber])
}
